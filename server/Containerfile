# syntax=docker/dockerfile:1
FROM --platform=linux/amd64 swift:6.4.3-noble AS build
WORKDIR /workspace
COPY Package.swift Package.resolved ./
COPY Sources ./Sources
RUN swift build -c release --static-swift-stdlib --product passkey-server

FROM --platform=linux/amd64 ubuntu:noble AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system passkey \
    && useradd --system --gid passkey --home /nonexistent --shell /usr/sbin/nologin passkey
COPY --from=build /workspace/.build/release/passkey-server /usr/local/bin/passkey-server
USER passkey
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/passkey-server"]
CMD ["serve"]
