{
  "name": "passkey-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev.ts",
    "routes": "tsr generate",
    "routes:watch": "tsr watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "test:worker": "bun run scripts/test-worker.ts",
    "build": "bun run build:client && cf build",
    "deploy": "bun run build:client && cf deploy",
    "build:client": "bun run routes && bun run scripts/build-client.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.81.5",
    "@tanstack/react-router": "1.121.34",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@cloudflare/workers-types": "4.20250617.0",
    "@happy-dom/global-registrator": "17.4.7",
    "@tanstack/router-cli": "1.121.34",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/bun": "1.3.13",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "cf": "1.0.0-rc.6",
    "happy-dom": "17.4.7",
    "typescript": "5.9.3",
    "workerd": "1.20261120.1",
    "wrangler": "4.166.0"
  }
}
